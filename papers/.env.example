# ─── RabbitHole backend configuration ───────────────────────────────
# Copy this file to papers/.env and fill in your real values.
# The .env file is gitignored and will NEVER be committed.
# NEVER put real API keys in this example file.

# ── LLM provider (priority: Gemini → Groq → OpenAI → mock) ──────────
#
# Option A: Google Gemini  ← start here
#   1. Visit https://aistudio.google.com  →  sign in  →  "Get API key"
#   2. No credit card needed. Free: 15 req/min · 1,500 req/day · 1M token context
#   3. Model: gemini-2.0-flash
#   NOTE: quota resets daily at midnight Pacific. Each paper = 1 API call.
#
GEMINI_API_KEY=

#
# Option B: Groq  ← best free backup when Gemini quota runs out
#   1. Visit https://console.groq.com  →  sign in  →  API Keys  →  Create key
#   2. No credit card needed. Free: 30 req/min · 14,400 req/day · 128k token context
#   3. Model: llama-3.3-70b-versatile (excellent quality, very fast)
#
GROQ_API_KEY=

#
# Option C: OpenAI  ← paid, but no daily limits
#   1. Visit https://platform.openai.com → API keys → Create new key
#   2. Requires a credit balance (~$5 minimum). Model: gpt-4o-mini
#
OPENAI_API_KEY=

# Set all three keys if you want — the backend uses whichever is listed first above.
# If none are set, the backend runs in MOCK mode (heuristic responses, no LLM cost).
#
# NOTE: course/RAG features (embeddings) require GEMINI_API_KEY specifically.

# ── Database (Supabase Postgres + pgvector) — required for course features ──
#   1. Create a free project at https://supabase.com
#   2. SQL Editor → run:  create extension if not exists vector;
#   3. Project Settings → Database → Connection string → URI → paste below
#   Example: postgresql://postgres:YOURPASSWORD@db.xxxxxxxx.supabase.co:5432/postgres
#
# If DATABASE_URL is empty, the /analyze + /explain features still work;
# only the /courses (RAG tutor) endpoints are disabled.
DATABASE_URL=

# ── Supabase Auth (required for the web dashboards) ────────────────────
#   Project Settings → API:
#     - Project URL  → SUPABASE_URL  (e.g. https://xxxx.supabase.co)
#     - anon/public key → SUPABASE_ANON_KEY  (long eyJ... string)
#   The backend validates web-app login tokens against these.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# ── Server ─────────────────────────────────────────────────────�