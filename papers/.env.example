# Optional: Set your OpenAI API key here
# Leave blank or set to "mock" to use mock responses for testing
OPENAI_API_KEY=YOUR_OPENAI_API_KEY_HERE


# Backend configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# For testing: set to "mock" to use mock backend responses
BACKEND_MODE=direct

# OpenAI API configuration
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_MODEL=gpt-3.5-turbo
OPENAI_TEMPERATURE=0.7
OPENAI_MAX_TOKENS=300

# Logging configuration
LOG_LEVEL=debug
LOG_FILE=papers.log

# CORS configuration (for backend)
ALLOW_ORIGINS=*
ALLOW_CREDENTIALS=true
ALLOW_METHODS=POST,GET,OPTIONS
ALLOW_HEADERS=Content-Type,Authorization

# Security: set a secret key for encryption/verification
SECRET_KEY=your_secret_key_here

# Feature flags (set to true/false)
ENABLE_PREVIEW=true
ENABLE_DRAFTS=false

# Rate limiting (for production use)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_IP=60
RATE_LIMIT_WINDOW_SECONDS=60

# Mock data configuration
MOCK_RESPONSES_DIR=mock_responses
MOCK_RESPONSES_ENABLED=false

# Test configuration (for local development)
TEST_BACKEND_URL=http://localhost:8000
TEST_OPENAI_API_KEY=sk-test-xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
