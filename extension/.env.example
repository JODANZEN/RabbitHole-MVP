# Extension build configuration.
# Copy to extension/.env. Used at BUILD time (npm run build), then baked into dist/.
#
# Local dev: leave unset — defaults to http://127.0.0.1:8000
# Production: set to your deployed backend, e.g.
# VITE_BACKEND_URL=https://rabbithole-api.onrender.com
VITE_BACKEND_URL=
